# -------------------------------------------------------------------
# Finance MVP — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes de rodar.
# NUNCA versione o arquivo .env.
# -------------------------------------------------------------------

# Chave secreta do Django. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-troque-por-uma-chave-segura

# Modo debug (True em dev, False em produção)
DEBUG=True

# URL do banco de dados
# SQLite (dev local):
DATABASE_URL=sqlite:///db.sqlite3
# Postgres (produção):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=127.0.0.1,localhost

# Origens permitidas pelo CORS (frontend em dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173
